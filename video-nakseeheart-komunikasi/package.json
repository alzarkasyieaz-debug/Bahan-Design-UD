{
  "name": "video-nakseeheart-komunikasi",
  "version": "1.0.0",
  "private": true,
  "description": "NakSeeHeart — Jaga Komunikasi Bila Jumpa Kawan Lama (video nasihat sinematik 9:16)",
  "scripts": {
    "prep": "bash scripts/prepare_media.sh",
    "audio": "python3 scripts/generate_audio.py",
    "studio": "remotion studio",
    "render": "remotion render NakSeeHeartKomunikasi out/nakseeheart-jaga-komunikasi.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=192k",
    "still": "remotion still NakSeeHeartKomunikasi out/preview.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "remotion": "4.0.542",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource/montserrat": "^5.2.5",
    "@types/react": "19.1.0",
    "typescript": "^5.6.0"
  }
}
