{
  "name": "video-lawatan-pps-parit",
  "version": "1.0.0",
  "private": true,
  "description": "Video dokumentari kemanusiaan 120s: Lawatan YB Ustaz Muhammad Ismi Mat Taib ke PPS SK Tanjung Belanja, Parit",
  "scripts": {
    "prep": "python3 scripts/prep_clips.py",
    "audio": "python3 scripts/generate_audio.py",
    "studio": "remotion studio",
    "render": "remotion render LawatanPPS out/lawatan-pps-sk-tanjung-belanja.mp4 --codec=h264 --crf=19 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "render:sabar": "remotion render LawatanPPS-Sabar out/lawatan-pps-sabar-ya.mp4 --codec=h264 --crf=19 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "render:ringkas": "remotion render LawatanPPS-Ringkas out/lawatan-pps-ringkas.mp4 --codec=h264 --crf=19 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k",
    "still": "remotion still LawatanPPS out/preview.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "^4.0.542",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource/montserrat": "^5.2.5",
    "@fontsource/playfair-display": "^5.2.5",
    "@types/react": "19.1.0",
    "typescript": "^5.6.0"
  }
}
