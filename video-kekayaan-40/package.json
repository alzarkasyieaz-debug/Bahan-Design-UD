{
  "name": "video-kekayaan-sebenar-40",
  "version": "1.0.0",
  "private": true,
  "description": "Video motivasi sinematik 120s: Selepas Umur 40 Tahun, Kekayaan Sebenar Adalah…",
  "scripts": {
    "audio": "python3 scripts/generate_audio.py",
    "vo:scan": "node scripts/scan-vo.mjs",
    "studio": "npm run vo:scan && remotion studio",
    "render": "npm run vo:scan && remotion render KekayaanSebenar out/kekayaan-sebenar-40.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac",
    "still": "remotion still KekayaanSebenar out/preview.png --frame=60"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "remotion": "4.0.542",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/playfair-display": "^5.2.5",
    "@types/react": "19.1.0",
    "typescript": "^5.6.0"
  }
}
