{
  "name": "video-kenangan-umrah",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic memory film 120s: Sebuah Rindu… Kenangan Indah di Tanah Suci",
  "scripts": {
    "photos": "python3 scripts/prepare_photos.py",
    "vo": "python3 scripts/generate_vo.py",
    "audio": "python3 scripts/generate_audio.py",
    "studio": "remotion studio",
    "render": "remotion render SebuahRindu out/sebuah-rindu-kenangan-umrah.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k",
    "still": "remotion still SebuahRindu out/preview.png --frame=90"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/fonts": "4.0.542",
    "remotion": "4.0.542",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource/poppins": "^5.2.5",
    "@types/react": "19.1.0",
    "typescript": "^5.6.0"
  }
}
